@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.ThematicStructureIndexViewModel

@{
    const string TITLE = "Estructura Temática";

    ViewData["Title"] = TITLE;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = @TITLE
        }
    };

    Layout = "_NavigableFrontendLayout";
}

@section styles {
    <style type="text/css">
        .badge {
            font-size: 100%;
            padding: .85em;
        }
    </style>
}

<h4 class="display-4">@TITLE</h4>

@Html.Raw(Model.Intro)

<div class="mt-4">
    <span class="badge badge-info"><span class="mdi mdi-bookmark"> Secciones</span></span>
    <span class="badge badge-info"><span class="mdi mdi-label"> Epígrafes</span></span>
    <span class="badge badge-info"><span class="mdi mdi-folder"> Temáticas</span></span>
    <span class="badge badge-info"><span class="mdi mdi-earth-box"> Mapas</span></span>
    <span class="badge badge-info"><span class="mdi mdi-chart-areaspline"> Gráficas</span></span>
    <span class="badge badge-info"><span class="mdi mdi-image"> Imágenes</span></span>
    <span class="badge badge-info"><span class="mdi mdi-youtube"> Videos</span></span>
    <span class="badge badge-info"><span class="mdi mdi-file"> Documentos</span></span>
</div>

@foreach (var item in Model.Structure)
{
    <div class="mt-4 mb-2">
        <h4><span class="mdi mdi-bookmark"></span> <a asp-action="index" asp-controller="section" asp-route-key="@item.Key.Id">@item.Key.Name</a></h4>
        <div class="text-truncate text-wrap" style="max-height: 72px;">
            @Html.Raw(@item.Key.Description)
        </div>
    </div>

    @foreach (var _item in item.Value)
    {
        <div class="ml-5 mt-3 mb-1">
            <h4><span class="mdi mdi-label"></span> <a asp-action="index" asp-controller="epigraph" asp-route-key="@_item.Key.Id">@_item.Key.Name</a></h4>
            <div class="text-truncate text-wrap" style="max-height: 72px;">
                @Html.Raw(@_item.Key.Description)
            </div>

            @foreach (var __item in _item.Value)
            {
                <div class="ml-5 mt-3 mb-1">
                    <h4><span class="mdi mdi-folder"></span> @__item.Key.Name</h4>

                    @foreach (var ___item in __item.Value)
                    {
                        <div class="ml-5 mt-2 mb-1">
                            <h4><span class="mdi mdi-earth-box"></span> <a asp-action="index" asp-controller="map" asp-route-key="@___item.Current.Id" asp-route-epigraphId="@_item.Key.Id">@___item.Current.Name</a></h4>
                            <div class="text-truncate text-wrap" style="max-height: 72px;">
                                @Html.Raw(@___item.Current.Description)
                            </div>

                            @if (___item.Graphs.Length > 0 || ___item.Pictures.Length > 0 || ___item.Videos.Length > 0 || ___item.Documents.Length > 0)
                            {
                                <div class="mb-4">
                                    @foreach (var ____item in ___item.Graphs)
                                    {
                                        <div class="ml-5 mt-2 mb-1">
                                            <h5><span class="mdi mdi-chart-areaspline"></span> <span>@Html.Raw(____item.About ?? "Gráfica sin descripción.")</span></h5>
                                        </div>
                                    }

                                    @foreach (var ____item in ___item.Pictures)
                                    {
                                        <div class="ml-5 mt-2 mb-1">
                                            <h5><span class="mdi mdi-image"></span> <span>@Html.Raw(____item.About ?? "Imágen sin descripción.")</span></h5>
                                        </div>
                                    }

                                    @foreach (var ____item in ___item.Videos)
                                    {
                                        <div class="ml-5 mt-2 mb-1">
                                            <h5><span class="mdi mdi-youtube"></span> <span>@Html.Raw(____item.About ?? "Video sin descripción.")</span></h5>
                                        </div>
                                    }

                                    @foreach (var ____item in ___item.Documents)
                                    {
                                        <div class="ml-5 mt-2 mb-1">
                                            <h5><span class="mdi mdi-file"></span> <span>@____item.Name</span></h5>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}