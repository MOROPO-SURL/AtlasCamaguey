@model MOROPO.Framework.Guama.Core.Presentation.Models.View.SelectionDescriptedItemInputViewModel<Guid>

<div class="col-md-6">
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Label)
    @Html.HiddenFor(model => model.Description)
    
    <div class="checkbox">
        <label class="h4">
            @Html.CheckBoxFor(model => model.Selected)
            @GlobalViewLocalizationHelper.Localize(Model.Label)
        </label>
        @if (string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted"><i>Descripción no especificada</i></p>
        }
        else
        {
            <p class="text-muted">@GlobalViewLocalizationHelper.Localize(Model.Description)</p>
        }
    </div>
</div>
