@model MOROPO.Framework.Guama.Core.Presentation.Models.View.SelectionItemInputViewModel<long>

<div class="col-md-6">
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Label)
    
    <div class="checkbox">
        <label class="h4">
            @Html.CheckBoxFor(model => model.Selected)
            @GlobalViewLocalizationHelper.Localize(Model.Label)
        </label>
    </div>
</div>
