            var drawingLayer = new L.featureGroup().addTo(map);

            var baseLayer = new L.tileLayer('http://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19
                //attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var overlay1Layer = new L.geoJSON.ajax('http://localhost/cgi-bin/qgis_mapserv.fcgi.exe?MAP=C:/OSGeo4W/var/proj/S3_E1_M7/S3_E1_M7.qgs&SERVICE=WFS&VERSION=1.1.0&REQUEST=GetFeature&TYPENAME=tasa_evejecimiento&OUTPUTFORMAT=geojson', {
                style: function(feature) {
                    if (feature.properties['Tasa'] >= 28.000000 && feature.properties['Tasa'] <= 30.200000) {
                        return {
                            opacity: 1,
                            color: 'rgba(35,35,35,1.0)',
                            dashArray: '',
                            lineCap: 'butt',
                            lineJoin: 'miter',
                            weight: 1.0,
                            fill: true,
                            fillOpacity: 1,
                            fillColor: 'rgba(255,255,212,1.0)',
                            interactive: true,
                        }
                    }
                    if (feature.properties['Tasa'] >= 30.200000 && feature.properties['Tasa'] <= 32.400000) {
                        return {
                            opacity: 1,
                            color: 'rgba(35,35,35,1.0)',
                            dashArray: '',
                            lineCap: 'butt',
                            lineJoin: 'miter',
                            weight: 1.0,
                            fill: true,
