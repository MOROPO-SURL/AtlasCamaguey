@section thematic_navigation
{
    <div id="nav-thematic" class="accordion">
    @foreach (var item in Model.Sections)
    {
        var listGroupItemCSSClasses = item.Id == Model.Section.Id ? "list-group-item bg-light" : "list-group-item";
        var listGroupItemHeadCSSClasses = item.Id == Model.Section.Id ? "section-nav-item-head" : "section-nav-item-head collapsed";
        var listGroupItemHeadContentCSSClasses = item.Id == Model.Section.Id ? "row no-gutters text-info" : "row no-gutters";
        var listGroupItemBodyCSSClasses = item.Id == Model.Section.Id ? "collapse show" : "collapse";
        var listGroupItemBodyItemsCSSClasses = item.Id == Model.Section.Id ? "list-group-item bg-light" : "list-group-item";

        <div class="@listGroupItemCSSClasses">
            <div id="section-nav-item-@item.Id-head" class="@listGroupItemHeadCSSClasses" data-toggle="collapse" data-target="#section-nav-item-@item.Id-content" aria-expanded="true" aria-controls="section-nav-item-2-content">
                <div class="@listGroupItemHeadContentCSSClasses">
                    <span class="col-auto mdi mdi-24px mdi-bookmark"></span>
                    <span class="col">
                        @if (item.Id == Model.Section.Id)
                        {
                            <b>@item.Name</b>
                        }
                        else
                        {
                            <span>@item.Name</span>
                        }
                    </span>
                    <span class="col-auto mdi mdi-24px mdi-chevron-up"></span>
                </div>
            </div>            

            <div id="section-nav-item-@item.Id-content" class="@listGroupItemBodyCSSClasses" aria-labelledby="section-nav-item-@item.Id-head" data-parent="#nav-thematic">
                @if (item.Id != Model.Section.Id)
                {
                    <hr class="bg-info" style="margin-top: 0.75rem" />                    
                }
                else
                {
                    <hr style="margin-top: 0.75rem" />
                }
                <a asp-action="Index" asp-controller="section" asp-route-key="@item.Id" class="card-link"><span class="mdi mdi-arrow-left-thick"></span> Detalles de la sección</a>
                <b class="d-block mt-2">Epígrafes</b>
                <ul class="list-group">
                    @foreach (var _item in item.Epigraphs)
                    {
                        <li class="@listGroupItemBodyItemsCSSClasses">
                            @if (_item.Id == Model.Epigraph.Id)
                            {
                                <a asp-action="index" asp-controller="epigraph" asp-route-key="@_item.Id">
                                    <div class="row no-gutters text-info">
                                        <span class="col-auto mdi mdi-24px mdi-label"></span>
                                        <span class="col"><b>@_item.Name</b></span>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a asp-action="index" asp-controller="epigraph" asp-route-key="@_item.Id">
                                    <div class="row no-gutters">
                                        <span class="col-auto mdi mdi-24px mdi-label"></span>
                                        <span class="col">@_item.Name</span>
                                    </div>
                                </a>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    </div>
}

<h4 class="mb-0">Mapa</h4>
<p class="display-4">@Model.Current.Name</p>
<div style="font-size: 1.5rem;">
    @Html.Raw(Model.Current.Description)
</div>
<div class="clearfix"></div>
<div class="row">    
    <div class="col-lg-9 col-md-8 col-sm-12">
        <div class="border rounded">
            <div id="map"></div>
        </div>

        <div class="mt-3 mb-1"><b><i>Autores</i></b></div>
        <ul class="mb-0">
            @foreach (var item in @Model.Authors)
            {
                var fullName = string.IsNullOrEmpty(item.LastName) ? item.Name : string.Format("{0} {1}", item.Name, item.LastName);

                @if (item.Institution != null)
                {
                    var institutionFullName = string.IsNullOrEmpty(item.Institution.Alias) ? item.Institution.Name : string.Format("{0} ({1})", item.Institution.Name, item.Institution.Alias);

                    <li>@string.Format("{0}, {1}", fullName, institutionFullName)</li>
                }
                else
                {
                    <li>@fullName</li> 
                }
            }
        </ul>
    </div>
    <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><span class="mdi mdi-map-legend"></span> Leyenda</h5>
            </div>
            <div class="card-body">
                <img class="img-fluid" src="http://localhost/cgi-bin/qgis_mapserv.fcgi.exe?MAP=C:/OSGeo4W/var/proj/S3_E1_M7/S3_E1_M7.qgs&SERVICE=WMS&VERSION=1.3.0&LAYERS=tasa_evejecimiento&REQUEST=GetLegendGraphic" />
                <img class="img-fluid" src="http://localhost/cgi-bin/qgis_mapserv.fcgi.exe?MAP=C:/OSGeo4W/var/proj/S3_E1_M7/S3_E1_M7.qgs&SERVICE=WMS&VERSION=1.3.0&LAYERS=adulto_mayor&REQUEST=GetLegendGraphic" />
            </div>
        </div>
    </div>
</div>

<hr class="my-5" />
<h3 class="mb-0">Modelos de datos</h3>
<small class="text-muted lead">Gráficas y tablas de datos relacionadas a la temática</small>
<div class="row mt-3">
    <div class="col-4">
        <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
            <div id="chart-1"></div>
        </div>
    </div>
    <div class="col-4">
        <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
            <div id="chart-2"></div>
        </div>
    </div>
    <div class="col-4">
        <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
            <div id="chart-3"></div>
        </div>
    </div>
</div>

@if (hasImages || hasVideos || hasDocuments)
{
    @if (hasImages)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Imágenes</h3>
        <small class="text-muted lead">instantáneas relacionadas a la temática</small>
        <div class="card-columns mt-3">
            @foreach (var item in Model.Images)
            {
                <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                    <img class="card-img" src="~/media/images/@item.Id.@item.Extension" />
                </div>
            }
        </div>
    }
    @if (hasVideos)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Videos</h3>
        <small class="text-muted lead">audiovisuales representativos disponibles</small>
        <div class="row mt-3">
            @foreach (var item in Model.Videos)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="embed-responsive embed-responsive-16by9">
                            <video controls="controls">
                                <source src="/media/videos/@item.Id.@item.Extension" type="video/mp4">
                                Su explorar no soporta nativamente la reproducción de videos.
                            </video>
                        </div>
                        <div class="card-body">
                            @if (string.IsNullOrEmpty(item.About))
                            {
                                <p class="text-muted mb-0"><i>Acerca de no especificado</i></p>
                            }
                            else
                            {
                                <p class="mb-0">@item.About</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (hasDocuments)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Documentos</h3>
        <small class="text-muted lead">material de consulta adicional</small>
        <div class="row mt-3">
            @foreach (var item in Model.Documents)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-auto pr-0"><span class="mdi mdi-36px @item.Extension.AsExtensionToMDICssClass()"></span></div>
                                <div class="col">
                                    <a asp-action="Document" asp-controller="Download" asp-route-key="@item.Id"><b>@item.Name</b></a>
                                    <p class="mb-0">
                                        @if (item.Description == null)
                                        {
                                            <span class="text-muted italic">Sin descripción</span>
                                        }
                                        else
                                        {
                                            <span style="color: #6c757d; word-wrap: break-word;">@item.Description</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
