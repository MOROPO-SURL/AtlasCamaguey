@using MOROPO.CIMAC.Atlas.Camaguey.Web.Extensions

@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.MapIndexViewModel

@{
    const string HEADER = "Mapa S3_E1_M7";

    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Sección",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Epígrafe",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = string.Format("<b>Mapa</b>: {0}", Model.Map.Name)
        }
    };



    Layout = "_NavigableFrontendLayout";

    var hasImages = Model.Images.Length > 0;
    var hasVideos = Model.Videos.Length > 0;
    var hasDocuments = Model.Documents.Length > 0;
}

@section styles
{
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/minimap/Control.MiniMap.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/fullscreen/Control.FullScreen.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/mouse-position/L.Control.MousePosition.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/grid/L.Grid.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/grouped-layers/leaflet.groupedlayercontrol.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/draw/leaflet.draw.css" />
    <link rel="stylesheet" href="~/lib/leaflet/plugins/draw-style-editor/css/Leaflet.StyleEditor.min.css" />
    <style type="text/css">
        #map {
            height: 720px;
        }
    </style>
}

@section scripts
{
    <script type="text/javascript" src="~/lib/leaflet/leaflet.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/minimap/Control.MiniMap.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/fullscreen/Control.FullScreen.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/mouse-position/L.Control.MousePosition.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/grid/L.Grid.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/grouped-layers/leaflet.groupedlayercontrol.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/draw/leaflet.draw.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/draw-style-editor/javascript/Leaflet.StyleEditor.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var map = L.map('map', {
                fullscreenControl: true,
                fullscreenControlOptions: {
                    position: 'topleft'
                },
                scrollWheelZoom: false,
                attributionControl: false
            }).setView([21.3792,-77.9184], 9);

            var drawingLayer = new L.featureGroup().addTo(map);

            var baseLayer = new L.tileLayer('http://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19
                //attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var overlay1Layer = new L.tileLayer.wms('http://localhost/cgi-bin/qgis_mapserv.fcgi.exe?MAP=C:/OSGeo4W/var/proj/S3_E1_M7/S3_E1_M7.qgs&SERVICE=WMS&VERSION=1.3.0&', {
                maxZoom: 19,
                version: '1.3.0',
                format: 'image/png',
                transparent: true,
                srs: L.CRS.EPSG4326,
                layers: 'tasa_evejecimiento'
            }).addTo(map);
            var overlay2Layer = new L.tileLayer.wms('http://localhost/cgi-bin/qgis_mapserv.fcgi.exe?MAP=C:/OSGeo4W/var/proj/S3_E1_M7/S3_E1_M7.qgs&SERVICE=WMS&VERSION=1.3.0&', {
                maxZoom: 19,
                version: '1.3.0',
                format: 'image/png',
                transparent: true,
                srs: L.CRS.EPSG4326,
                layers: 'adulto_mayor'
            }).addTo(map);

            var grid = new L.grid().addTo(map);

            L.control.groupedLayers(null, { 
                "Capas de datos": {
                    'Envejecimiento poblacional (%)': overlay1Layer,
                    'Adulto mayor (personas)': overlay2Layer
                },
                "Capas auxiliares": {
                    'Regilla de coordenadas': grid,
                    'Trazos sobre el mapa': drawingLayer
                }
	        }, {
                hideSingleBase: true,
		        collapsed: false
	        }).addTo(map);

            L.control.mousePosition({
                emptyString: '0º N<br>0º E',
                separator: '<br>',
                lngFormatter: function(num) {
                    var direction = (num < 0) ? 'W' : 'E';
                    
                    var formatted = Math.abs(L.Util.formatNum(num, 3)) + 'º ' + direction;
                    
                    return formatted; 
                },
                latFormatter: function(num) {
                    var direction = (num < 0) ? 'S' : 'N';
                    
                    var formatted = Math.abs(L.Util.formatNum(num, 3)) + 'º ' + direction;
                    
                    return formatted;
                }
            }).addTo(map);
            L.control.scale().addTo(map);

            map.addControl(new L.Control.Draw({
                edit: {
                    featureGroup: drawingLayer,
                    poly: {
                        allowIntersection: false
                    }
                },
                draw: {
                    polygon: {
                        allowIntersection: false,
                        showArea: true
                    }
                }
            }));
            map.on(L.Draw.Event.CREATED, function (event) {
                var drawLayer = event.layer;

                drawingLayer.addLayer(drawLayer);
            });

            map.addControl(L.control.styleEditor());
            
            var miniMap = new L.Control.MiniMap(new L.tileLayer('http://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }), { toggleDisplay: true }).addTo(map);
        });

        //var mapa = new ol.Map({
        //    target: 'map',
        //    layers: [
        //        //new ol.layer.Tile({
        //        //    source: new ol.source.OSM()
        //        //}),
        //        //new ol.layer.Tile({
        //        //    source: new ol.source.TileWMS({
        //        //        url: 'http://qgis.moropo.cu/cgi-bin/qgis_mapserv.fcgi',
        //        //        params: {
        //        //            'MAP': '@string.Format("/home/cloud/qgisprojects/{0}/{0}.qgz", Model.Map.Id)',
        //        //            'LAYERS': 'Tasa de envejecimiento (%),Adulto mayor (personas)',
        //        //            'CRS': 'EPSG:4326'
        //        //        }
        //        //    })
        //        //}),
        //        new ol.layer.Vector({
        //            source: new ol.source.Vector({
        //                loader: function() {
        //                    $.ajax({
        //                        type: 'GET',
        //                        url: '/media/geojson/s3_e1_m7/data/Embalses_0.json',
        //                        context: this
        //                    }).done(function(data) {
        //                        alert(data);

        //                        var format = new ol.format.GeoJSON();

        //                        this.addFeatures(format.readFeatures(data));
        //                    });
        //                }
        //            })
        //        })
        //    ],
        //    view: new ol.View({
        //        center: ol.proj.fromLonLat([-77.9184, 21.3792]),
        //        //center: [0, 0],
        //        zoom: 9
        //        //zoom: 2
        //    })
        //});
    </script>
}

<h4 class="mb-0">Mapa</h4>
<p class="display-4">@Model.Map.Name</p>
<div style="font-size: 1.5rem;">
    @Html.Raw(Model.Map.Description)
</div>
<div class="clearfix"></div>
<div class="row">    
    <div class="col-lg-9 col-md-8 col-sm-12">
        <div class="border rounded">
            <div id="map"></div>
        </div>

        <div class="mt-3 mb-1"><b><i>Autores</i></b></div>
        <ul class="mb-0">
            @foreach (var item in @Model.Authors)
            {
                var fullName = string.IsNullOrEmpty(item.LastName) ? item.Name : string.Format("{0} {1}", item.Name, item.LastName);

                @if (item.Institution != null)
                {
                    var institutionFullName = string.IsNullOrEmpty(item.Institution.Alias) ? item.Institution.Name : string.Format("{0} ({1})", item.Institution.Name, item.Institution.Alias);

                    <li>@string.Format("{0}, {1}", fullName, institutionFullName)</li>
                }
                else
                {
                    <li>@fullName</li> 
                }
            }
        </ul>
    </div>
    <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><span class="mdi mdi-map-legend"></span> Leyenda</h5>
            </div>
            <div class="card-body">
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
            </div>
        </div>
    </div>
</div>
@if (hasImages || hasVideos || hasDocuments)
{
    @if (hasImages)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Imágenes</h3>
        <small class="text-muted lead">instantáneas relacionadas a la temática</small>
        <div class="card-columns mt-3">
            @foreach (var item in Model.Images)
            {
                <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                    <img class="card-img" src="~/media/images/@item.Id.@item.Extension" />
                </div>
            }
        </div>
    }
    @if (hasVideos)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Videos</h3>
        <small class="text-muted lead">audiovisuales representativos disponibles</small>
        <div class="row mt-3">
            @foreach (var item in Model.Videos)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="embed-responsive embed-responsive-16by9">
                            <video controls="controls">
                                <source src="/media/videos/@item.Id.@item.Extension" type="video/mp4">
                                Su explorar no soporta nativamente la reproducción de videos.
                            </video>
                        </div>
                        <div class="card-body">
                            @if (string.IsNullOrEmpty(item.About))
                            {
                                <p class="text-muted mb-0"><i>Acerca de no especificado</i></p>
                            }
                            else
                            {
                                <p class="mb-0">@item.About</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (hasDocuments)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Documentos</h3>
        <small class="text-muted lead">material de consulta adicional</small>
        <div class="row mt-3">
            @foreach (var item in Model.Documents)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-auto pr-0"><span class="mdi mdi-36px @item.Extension.AsExtensionToMDICssClass()"></span></div>
                                <div class="col">
                                    <a asp-action="Document" asp-controller="Download" asp-route-key="@item.Id"><b>@item.Name</b></a>
                                    <p class="mb-0">
                                        @if (item.Description == null)
                                        {
                                            <span class="text-muted italic">Sin descripción</span>
                                        }
                                        else
                                        {
                                            <span style="color: #6c757d; word-wrap: break-word;">@item.Description</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
