@using MOROPO.CIMAC.Atlas.Camaguey.Web.Extensions

@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.MapIndexViewModel

@{
    var header = string.Format("Mapa {0}", Model.Current.Id.ToUpperInvariant());

    ViewData["Title"] = header;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Sección",
            Url = Url.Action("Index", "Section", new { key = Model.Section.Id })
        },
        new BreadcrumbViewModel
        {
            Caption = "Epígrafe",
            Url = Url.Action("Index", "Epigraph", new { key = Model.Epigraph.Id })
        },
        new BreadcrumbViewModel
        {
            Caption = string.Format("<b>Mapa</b>: {0}", Model.Current.Id)
        }
    };



    Layout = "_ThematicNavigableFrontendLayout";
}

@section styles
{
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.min.css" />
    @*<link rel="stylesheet" href="~/lib/leaflet-draw-style-editor/css/Leaflet.StyleEditor.min.css" />*@
    <link rel="stylesheet" href="~/lib/leaflet-fullscreen/dist/leaflet.fullscreen.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-control-boxzoom/dist/leaflet-control-boxzoom.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-navbar/Leaflet.NavBar.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-minimap/Control.MiniMap.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-mouse-position/src/L.Control.MousePosition.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-html-legend/dist/L.Control.HtmlLegend.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-grid/L.Grid.css" />
    <link rel="stylesheet" href="~/lib/leaflet-easybutton/src/easy-button.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-sidebar/src/L.Control.Sidebar.css" />
    <link rel="stylesheet" href="~/lib/leaflet-groupedlayercontrol/leaflet.groupedlayercontrol.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-measure-path/leaflet-measure-path.min.css" />
    <link rel="stylesheet" href="~/lib/leaflet-geoman-free/dist/leaflet-geoman.min.css" />
    <link rel="stylesheet" href="~/lib/apexcharts/apexcharts.min.css" />
    <style type="text/css">
        #map {
            height: 936px;
        }

        #nav-thematic .list-group-item {
            padding: 0.65rem;
        }

        #nav-thematic:first-child {
            border-top: 1px solid rgba(0,0,0,.125);
        }

        #nav-thematic .list-group-item > div.section-nav-item-head > div.row > span.mdi-chevron-up {
            transition: all 0.3s ease;
        }

        #nav-thematic .list-group-item > div.section-nav-item-head.collapsed > div.row > span.mdi-chevron-up {
            -webkit-transform: rotate(180deg);
            -moz-transform: rotate(180deg);
            -ms-transform: rotate(180deg);
            transform: rotate(180deg);
        }

        #nav-thematic .list-group-item .card-body {
            margin-top: 0.25rem;
        }

        #nav-thematic .list-group-item div.row.no-gutters > span {
            align-self: center;
        }       

        #nav-thematic .list-group-item div.row.no-gutters > span.col {
            margin: 0 0.25rem;
        }

        .leaflet-tooltip-left:before, .leaflet-tooltip-right:before {
            top: 10%;
        }

        .leaflet-html-legend {
            max-height: inherit !important;
            width: auto !important;
            overflow: inherit !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }
        .leaflet-control-layers-list {
            margin-top: 8px;
        }
        .leaflet-control-layers-group-name {
            font-weight: bold;
            font-size: 1.25em;
            color: dimgray;
        }
        .leaflet-control-layers-group > label > span {
            font-size: 1.2em;
        }
        #layer-manager-control-implicit-collapse-toggle-icon.collapsed::before {
            content: '\F0F58';
        }
        #legend-control-implicit-collapse-toggle-icon.collapsed::before {
            content: '\FA00';
        }
        .legend-block > .visibility-toggle, .legend-block > .opacity-slider {
            display: none !important;
        }
        .leaflet-control-layers-expanded {
            padding: 6px;
        }
        .control-implicit-collapse-toggle {
            display: inline-block;
            width: 16px;
            height: 16px;
            background-color:black;
        }
        .control-implicit-collapse-toggle > span::before, .easy-button-button > span.button-state > span.mdi::before {
            font-size: 18px;
        }
        .leaflet-control-boxzoom {
            border: 2px solid rgba(0, 0, 0, .2);
            background-clip: padding-box;
            width: 34px;
            height: 34px;
            line-height: 34px;
            background-position: 5px 4px;
            box-shadow: none;
        }
        .leaflet--printing .leaflet-control-fullscreen {
            display: none !important;
        }
    </style>
}

@section scripts
{
    <script type="text/javascript" src="~/lib/leaflet/leaflet.min.js"></script>
    @*<script type="text/javascript" src="~/lib/leaflet-draw-style-editor/javascript/Leaflet.StyleEditor.min.js"></script>*@
    <script type="text/javascript" src="~/lib/leaflet-fullscreen/dist/leaflet.fullscreen.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-control-boxzoom/dist/leaflet-control-boxzoom.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-navbar/index.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-control-custom/Leaflet.Control.Custom.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-minimap/Control.MiniMap.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-mouse-position/src/L.Control.MousePosition.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-html-legend/dist/L.Control.HtmlLegend.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-sidebar/src/L.Control.Sidebar.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-easybutton/src/easy-button.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-browser-print/dist/leaflet.browser.print.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-grid/L.Grid.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-groupedlayercontrol/leaflet.groupedlayercontrol.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-ajax/leaflet.ajax.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-measure-path/leaflet-measure-path.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet-geoman-free/dist/leaflet-geoman.min.js"></script>
    <script type="text/javascript" src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script type="text/javascript">

        var highlightLayer;

        function validateCoordinates(lat, lng) {
            if (typeof lat !== 'number' || typeof lng !== 'number') {
                return false; // Ensure input is a number
            }
            if (lat == NaN || lng == NaN) {
                return false; // Ensure input is a number
            }
            if (lat < -90 || lat > 90) {
                return false; // Invalid latitude
            }
            if (lng < -180 || lng > 180) {
                return false; // Invalid longitude
            }

            return true; // Valid coordinates
        }

        $(document).ready(function () {
            L.BrowserPrint.Utils.registerLayer(
	            // Actual typeof object to compare with
	            L.Marker.Measurement,
	            // Any string you would like for current function for print events
	            'L.Marker.Measurement',
	            function (layer, utils) {
		            // We need to recreate cluster object with available options
		            // Here we use function, but we can use object aswell,
		            // example: new L.MarkerClusterGroup(layer._group.options);
		            var cluster = L.marker.measurement(layer._latlng, layer._measurement, layer._title, layer._rotation, layer.options);

		            return cluster;
	            });

            var sidebar = L.control.sidebar('sidebar', {
                closeButton: true,
                position: 'left'
            });        

            var map = L.map('map', {
                fullscreenControl: true,
                fullscreenControlOptions: {
                    position: 'topleft'
                },
                scrollWheelZoom: false,
                attributionControl: false
            }).setView([21.3792,-77.9184], 9);

            L.control.custom({
                position: 'topleft',
                content : '<div style="border: 2px solid rgba(0, 0, 0, .2); background-clip: padding-box; border-radius: 4px;">' +
                          '  <div class="input-group input-group-sm">' +
                          '    <input type="text" aria-label="Latitud" class="form-control" placeholder="lat: ej. 22.00031" id="set-map-view-lat-input">' +
                          '    <input type="text" aria-label="Longitud" class="form-control" placeholder="lng: ej. -77.00321" id="set-map-view-lng-input">' +
                          '    <div class="input-group-append">' +
                          '      <button class="btn btn-secondary" type="button" id="set-map-view-button"><span class="mdi mdi-target-variant"></span> Ir</button>' +
                          '    </div>' +
                          '  </div>' +
                          '</div>',
                classes : '',
                style   :
                {
                    position: 'absolute',
                    left: '48px',
                    top: '0px',
                    width: '320px',
                },
            })
            .addTo(map);

            $('#set-map-view-button').click(function() {
                var latitude = parseFloat(document.getElementById('set-map-view-lat-input').value);
                var longitude = parseFloat(document.getElementById('set-map-view-lng-input').value);

                if (validateCoordinates(latitude, longitude)) {
                    try {
                        map.setView([latitude, longitude], map.getZoom());

                        document.getElementById('set-map-view-lat-input').value = null;
                        document.getElementById('set-map-view-lng-input').value = null;
                    }
                    catch {
                        alert("Por favor, especifique valores válidos para las coordenadas.");
                    }
                } else {
                    alert("Por favor, especifique valores válidos para las coordenadas.");
                }
            });

            map.addControl(sidebar);

            L.control.navbar({
                position: 'topleft',
                center: L.latLng([21.3792,-77.9184]),
                zoom: 9
            }).addTo(map);

            L.Control.boxzoom({ position:'topleft' }).addTo(map);

            L.easyButton({
                position: 'topleft',
                states: [{
                    stateName: 'to-show-sidebar',
                    icon: '<span class="mdi mdi-file-table-box-outline"></span>',
                    title: 'Mostrar metadatos',
                    onClick: function(btn, map) {
                        sidebar.toggle();
                    }
                }]
            }).addTo(map);

            L.control.browserPrint({
                position: 'topleft', 
                title: '@Model.Current.Name',
                printModes: [
                    L.BrowserPrint.Mode.Landscape("Letter", {title: "Mapa Horizontal"}),
                    L.BrowserPrint.Mode.Portrait("Letter", {title: "Mapa Vertical"}),
                    L.BrowserPrint.Mode.Custom("Letter", {title:"Área del Mapa"})
	            ]
            }).addTo(map);

            var drawingLayer = new L.featureGroup().addTo(map);

            drawingLayer.on('add', () =>
            {
                drawingLayer.eachLayer(function (layer) {
                    if (layer.showMeasurements == null) return;
                    
                    layer.showMeasurements();
                });
            });

            var baseLayer = new L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', 
            {
	            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
	            subdomains: 'abcd',
	            maxZoom: 19
            }).addTo(map);

            var legendItems = [];

            @{
                var index = 0;

                if (!string.IsNullOrEmpty(Model.Current.PreLayersJSBlock))
                {
                    @Html.Raw(Model.Current.PreLayersJSBlock);
                }

                foreach (var item in Model.Current.Layers)
                {
                    if (item.PresentationStrategy == MOROPO.CIMAC.Atlas.Camaguey.Persistence.Enumerations.LayerPresentationStrategy.WFS)
                    {
                        var geoJSONUrl = string.Format("{0}?MAP={1}/{2}/{2}.qgz&SERVICE=WFS&VERSION=1.1.0&REQUEST=GetFeature&TYPENAME={3}&OUTPUTFORMAT=geojson", Model.QgisServerBaseUri, Model.QgisProjectsRootPath.Replace("\\", "/"), Model.Current.Id, System.Web.HttpUtility.UrlEncode(item.Name));

                        var layerDefinition = string.Format("       var overlayLayer{0} = new L.geoJSON.ajax('{1}'", ++index, geoJSONUrl) + ", { ";

                        if (!string.IsNullOrEmpty(item.StylePresentantionJSBlock) && !string.IsNullOrWhiteSpace(item.StylePresentantionJSBlock))
                        {
                            layerDefinition += 
                                "   style: function(feature) { " +
                                string.Format("       {0} ", item.StylePresentantionJSBlock) +
                                "   }, ";
                        }

                        if (!string.IsNullOrEmpty(item.InteractivePresentantionJSBlock) && !string.IsNullOrWhiteSpace(item.InteractivePresentantionJSBlock))
                        {
                            layerDefinition +=  
                                "   onEachFeature: function(feature, layer) { " +
                                string.Format("       {0} ", item.InteractivePresentantionJSBlock) +
                                "   } ";
                        }

                        if (!string.IsNullOrEmpty(item.PointToPresentationJSBlock) && !string.IsNullOrWhiteSpace(item.PointToPresentationJSBlock))
                        {
                            layerDefinition +=  
                                "   pointToLayer: function(feature, latlng) { " +
                                string.Format("       {0} ", item.PointToPresentationJSBlock) +
                                "   } ";
                        }

                        layerDefinition += "}).addTo(map);";

                        @Html.Raw(layerDefinition)
                    }
                    else
                    {
                        @Html.Raw($"{System.Environment.NewLine}var overlayLayer{++index} = new L.tileLayer.wms('{Model.QgisServerBaseUri}?MAP={Model.QgisProjectsRootPath.Replace("\\", "/")}/{Model.Current.Id}/{Model.Current.Id}.qgz&SERVICE=WMS&VERSION=1.3.0&', {{ maxZoom: 19, version: '1.3.0', format: 'image/png', transparent: true, srs: L.CRS.EPSG4326, layers: '{System.Web.HttpUtility.UrlEncode(item.Name)}'}}).addTo(map);")
                    }

                    @Html.Raw($"{System.Environment.NewLine}legendItems[{index}] = {{ layer: overlayLayer{index}, elements: [{{ html: '<img src=\"{Model.QgisServerBaseUri}?MAP={Model.QgisProjectsRootPath.Replace("\\", "/")}/{Model.Current.Id}/{Model.Current.Id}.qgz&SERVICE=WMS&VERSION=1.3.0&LAYERS={System.Web.HttpUtility.UrlEncode(item.Name)}&REQUEST=GetLegendGraphic&FORMAT=image/png&LAYERFONTBOLD=TRUE\" />' }}] }};");                                    
                }
            }

            var grid = new L.grid().addTo(map);

            const layerManager = L.control.groupedLayers(null, { 
                "Capas de datos": {
                    @{
                        index = 0;

                        foreach (var item in Model.Current.Layers)
                        {
                            @Html.Raw(string.Format("'{1}': overlayLayer{0},", ++index, item.Title))
                        }
                    }
                },
                "Capas auxiliares": {
                    'Regilla de coordenadas': grid,
                    'Trazos sobre el mapa': drawingLayer
                }
	        }, {
                hideSingleBase: true,
		        collapsed: false
            }).addTo(map);

            const layerManagerHeaderContainer = L.DomUtil.create('div');

            const layerManagerHeader = L.DomUtil.create('h3', 'h3 mb-3');

            layerManagerHeader.setAttribute("style", "min-width: 164px !important;");
            layerManagerHeader.innerHTML = '<span class="mdi mdi-layers-triple"></span> Capas';

            const layerManagerToggleButtonContainer = L.DomUtil.create('div', 'leaflet-bar leaflet-control m-0');

            const layerManagerToggleButton = L.DomUtil.create('a', 'control-implicit-collapse-toggle');

            L.DomEvent.on(layerManagerToggleButton, 'click', () => {			    
			    if (layerManagerHeader.style.display == 'none')
                    layerManagerHeader.style.display = 'block';
                else
                    layerManagerHeader.style.display = 'none';

                var mainInnerTarget = $('form.leaflet-control-layers-list');
                var icon = $('#layer-manager-control-implicit-collapse-toggle-icon');

                if (mainInnerTarget.hasClass('d-none')) {
                    mainInnerTarget.removeClass('d-none');
                    icon.removeClass('collapsed');
                } else {
                    mainInnerTarget.addClass('d-none');
                    icon.addClass('collapsed');
                }
		    }, L.DomEvent.stopPropagation);
            
            layerManagerToggleButton.innerHTML = '<span id="layer-manager-control-implicit-collapse-toggle-icon" class="mdi mdi-arrow-collapse"></span>';
            layerManagerToggleButton.setAttribute("href", "javascript:;");
            layerManagerToggleButton.setAttribute("title", "Visibilidad del Gestor de capas");

            layerManagerToggleButtonContainer.append(layerManagerToggleButton);

            layerManagerHeaderContainer.append(layerManagerToggleButtonContainer);
            layerManagerHeaderContainer.append(layerManagerHeader);

            layerManager.getContainer().insertBefore(layerManagerHeaderContainer, layerManager.getContainer().firstChild);

            const legend = L.control.htmllegend(
            {
                position: 'topright',
                collapsedOnInit: false,
                collapseSimple: true,
                disableVisibilityControls: true,
                visibleIcon: null,
                legends: legendItems
            }).addTo(map);

            const legendHeaderContainer = L.DomUtil.create('div');

            const legendHeader = L.DomUtil.create('h3', 'h3 mb-0');

            legendHeader.setAttribute("style", "min-width: 192px !important;");
            legendHeader.innerHTML = '<span class="mdi mdi-map-legend"></span> Leyenda';

            const legendToggleButtonContainer = L.DomUtil.create('div', 'leaflet-bar leaflet-control m-0');

            const legendToggleButton = L.DomUtil.create('a', 'control-implicit-collapse-toggle');

            L.DomEvent.on(legendToggleButton, 'click', () => {			    
			    if (legendHeader.style.display == 'none')
                    legendHeader.style.display = 'block';
                else
                    legendHeader.style.display = 'none';

                var mainInnerTarget = $('div.legend-block');
                var icon = $('#legend-control-implicit-collapse-toggle-icon');

                if (mainInnerTarget.hasClass('d-none')) {
                    mainInnerTarget.removeClass('d-none');
                    icon.removeClass('collapsed');
                } else {
                    mainInnerTarget.addClass('d-none');
                    icon.addClass('collapsed');
                }
		    }, L.DomEvent.stopPropagation);

            legendToggleButton.innerHTML = '<span id="legend-control-implicit-collapse-toggle-icon" class="mdi mdi-arrow-collapse"></span>';
            legendToggleButton.setAttribute("href", "javascript:;");
            legendToggleButton.setAttribute("title", "Visibilidad de la leyenda");

            legendToggleButtonContainer.append(legendToggleButton);

            legendHeaderContainer.append(legendToggleButtonContainer);
            legendHeaderContainer.append(legendHeader);

            legend.getContainer().insertBefore(legendHeaderContainer, legend.getContainer().firstChild);

            @if (!string.IsNullOrEmpty(Model.Current.PostLayersJSBlock))
            {
                @Html.Raw(Model.Current.PostLayersJSBlock);
            }

            L.control.mousePosition({
                emptyString: '0º N<br>0º E',
                separator: '<br>',
                lngFormatter: function(num) {
                    var direction = (num < 0) ? 'W' : 'E';
                    
                    var formatted = Math.abs(L.Util.formatNum(num, 3)) + 'º ' + direction;
                    
                    return formatted; 
                },
                latFormatter: function(num) {
                    var direction = (num < 0) ? 'S' : 'N';
                    
                    var formatted = Math.abs(L.Util.formatNum(num, 3)) + 'º ' + direction;
                    
                    return formatted;
                }
            }).addTo(map);

            L.control.scale().addTo(map);

            map.pm.addControls({  
              position: 'bottomleft'
            });
            map.pm.setGlobalOptions({ layerGroup: drawingLayer });
            map.pm.setLang("es");

            map.on('pm:create', ({ shape, layer }) => {
                if (layer.showMeasurements == null) return;

                layer.showMeasurements();
            });

            @*
            map.addControl(L.control.styleEditor({
                strings: {
                    cancel: 'Cancelar',
                    cancelTitle: 'Cancelar Persoliazación',
                    tooltip: 'Seleccione el elemento que desea personalizar',
                    tooltipNext: 'Seleccione otro elemento que desea personalizar'
                }
            }));
            *@
            
            var miniMap = new L.Control.MiniMap(new L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
	            subdomains: 'abcd'
            }), { toggleDisplay: true }).addTo(map);
        });
    </script>
}

@section thematic_navigation
{
    <div id="nav-thematic" class="accordion">
    @foreach (var item in Model.Sections)
    {
        var listGroupItemCSSClasses = item.Id == Model.Section.Id ? "list-group-item bg-light" : "list-group-item";
        var listGroupItemHeadCSSClasses = item.Id == Model.Section.Id ? "section-nav-item-head" : "section-nav-item-head collapsed";
        var listGroupItemHeadContentCSSClasses = item.Id == Model.Section.Id ? "row no-gutters text-info" : "row no-gutters";
        var listGroupItemBodyCSSClasses = item.Id == Model.Section.Id ? "collapse show" : "collapse";
        var listGroupItemBodyItemsCSSClasses = item.Id == Model.Section.Id ? "list-group-item bg-light" : "list-group-item";

        <div class="@listGroupItemCSSClasses">
            <div id="section-nav-item-@item.Id-head" class="@listGroupItemHeadCSSClasses" data-toggle="collapse" data-target="#section-nav-item-@item.Id-content" aria-expanded="true" aria-controls="section-nav-item-2-content">
                <div class="@listGroupItemHeadContentCSSClasses">
                    <span class="col-auto mdi mdi-24px mdi-bookmark"></span>
                    <span class="col">
                        @if (item.Id == Model.Section.Id)
                        {
                            <b>@item.Name</b>
                        }
                        else
                        {
                            <span>@item.Name</span>
                        }
                    </span>
                    <span class="col-auto mdi mdi-24px mdi-chevron-up"></span>
                </div>
            </div>            

            <div id="section-nav-item-@item.Id-content" class="@listGroupItemBodyCSSClasses" aria-labelledby="section-nav-item-@item.Id-head" data-parent="#nav-thematic">
                @if (item.Id != Model.Section.Id)
                {
                    <hr class="bg-info" style="margin-top: 0.75rem" />                    
                }
                else
                {
                    <hr style="margin-top: 0.75rem" />
                }
                <a asp-action="Index" asp-controller="section" asp-route-key="@item.Id" class="card-link"><span class="mdi mdi-arrow-left-thick"></span> Detalles de la sección</a>
                <b class="d-block mt-2">Epígrafes</b>
                <ul class="list-group">
                    @foreach (var _item in item.Epigraphs)
                    {
                        <li class="@listGroupItemBodyItemsCSSClasses">
                            @if (_item.Id == Model.Epigraph.Id)
                            {
                                <a asp-action="index" asp-controller="epigraph" asp-route-key="@_item.Id">
                                    <div class="row no-gutters text-info">
                                        <span class="col-auto mdi mdi-24px mdi-label"></span>
                                        <span class="col"><b>@_item.Name</b></span>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a asp-action="index" asp-controller="epigraph" asp-route-key="@_item.Id">
                                    <div class="row no-gutters">
                                        <span class="col-auto mdi mdi-24px mdi-label"></span>
                                        <span class="col">@_item.Name</span>
                                    </div>
                                </a>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    </div>
}

<h4 class="mb-0">Mapa</h4>
<p class="display-4">@Model.Current.Name</p>
<div id="sidebar">
    <h3 class="my-3">Metadatos</h3>
    <table class="table" style="margin: 0;">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Current.MetadataEntries.Length <= 0)
            {
                <tr><td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td></tr>
            }
            else
            {
                @foreach (var item in Model.Current.MetadataEntries)
                {
                    <tr>
                        <td style="vertical-align: middle;">@item.Name</td>
                        <td style="vertical-align: middle;">@item.Value</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="border rounded">
    <div id="map"></div>
</div>

<div class="mt-3 mb-1"><b><i>Autores</i></b></div>
<div class="row">
@foreach (var item in Model.Authors)
{
    <div class="col-lg-4 col-md-6 mb-4">
        <div class="media">
        @if (item.ImageId != null)
        {
            <img class="mr-2 img-fluid img-thumbnail" style="width: 64px; height: 64px;" src="~/media/images/@item.ImageId@item.ImageExtension">
        }
        else
        {
            <img class="mr-2 img-fluid img-thumbnail" style="width: 64px; height: 64px;" src="~/img/default-person-picture.jpg">
        }                
            <div class="media-body">
                <h4 class="mt-0">                
                    @if (item.NamePrefix != null)
                    {
                        <span>@item.NamePrefix</span>
                    }
                    <span>@item.Name</span>
                    @if (item.LastName != null)
                    {
                        <span>@item.LastName</span>
                    }
                </h4>
                @if (item.Institution != null)
                {
                    <p><span class="mdi mdi-domain"></span> @item.Institution.Name</p>
                }
                @if (item.About != null)
                {
                    <p>@item.About</p>
                }
            </div>
        </div>
    </div>
}
</div>

