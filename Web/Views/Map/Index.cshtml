@using MOROPO.CIMAC.Atlas.Camaguey.Web.Extensions

@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.MapIndexViewModel

@{
    const string HEADER = "Mapa";
    
    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Sección",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Epígrafe",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = string.Format("<b>Mapa</b>: {0}", Model.Map.Name)
        }
    };

    

    Layout = "_NavigableFrontendLayout";

    var hasImages = Model.Images.Length > 0;
    var hasVideos = Model.Videos.Length > 0;
    var hasDocuments = Model.Documents.Length > 0;
}

@section styles
{
    <link rel="stylesheet" href="~/lib/OpenLayer/css/ol.css" />
    <style type="text/css">
        #map {
            height: 720px;
        }
    </style>
}

@section scripts
{
    <script type="text/javascript" src="~/lib/OpenLayer/js/ol.js"></script>
    <script type="text/javascript">
        var mapa = new ol.Map({
            target: 'map',
            layers: [
                new ol.layer.Tile({
                    source: new ol.source.OSM()
                }),
                new ol.layer.Tile({
                    source: new ol.source.TileWMS({
                        url: 'http://qgis.moropo.cu/cgi-bin/qgis_mapserv.fcgi',
                        params: {
                            'MAP': '/home/cloud/qgisprojects/CayoSabinal/PlayaCayoSabinal.qgs',
                            'LAYERS': 'Red de monitoreo de playa,Cayo_Cabinal',
                            'CRS': 'EPSG:3795'
                        }
                    })
                })
            ],
            view: new ol.View({
                center: ol.proj.fromLonLat([-77.265024,21.662724]),
                zoom: 12
            })
        });
    </script>
}

<h4 class="mb-0">Mapa</h4>
<p class="display-4">@Model.Map.Name</p>
<div style="font-size: 1.5rem;">
    @Html.Raw(Model.Map.Description)
</div>
<div class="clearfix"></div>
<div class="row">    
    <div class="col-lg-9 col-md-8 col-sm-12">
        <div id="map"></div>

        <div class="mt-3 mb-1"><b><i>Autores</i></b></div>
        <ul class="mb-0">
            @foreach (var item in @Model.Authors)
            {
                var fullName = string.IsNullOrEmpty(item.LastName) ? item.Name : string.Format("{0} {1}", item.Name, item.LastName);

                @if (item.Institution != null)
                {
                    var institutionFullName = string.IsNullOrEmpty(item.Institution.Alias) ? item.Institution.Name : string.Format("{0} ({1})", item.Institution.Name, item.Institution.Alias);

                    <li>@string.Format("{0}, {1}", fullName, institutionFullName)</li>
                }
                else
                {
                    <li>@fullName</li> 
                }
            }
        </ul>
    </div>
    <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><span class="mdi mdi-map-legend"></span> Leyenda</h5>
            </div>
            <div class="card-body">
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
                <hr class="my-4" />
            </div>
        </div>
    </div>
</div>
@if (hasImages || hasVideos || hasDocuments)
{
    @if (hasImages)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Imágenes</h3>
        <small class="text-muted lead">instantáneas relacionadas a la temática</small>
        <div class="card-columns mt-3">
            @foreach (var item in Model.Images)
            {
                <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                    <img class="card-img" src="~/media/images/@item.Id.@item.Extension" />
                </div>
            }
        </div>
    }
    @if (hasVideos)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Videos</h3>
        <small class="text-muted lead">audiovisuales representativos disponibles</small>
        <div class="row mt-3">
            @foreach (var item in Model.Videos)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="embed-responsive embed-responsive-16by9">
                            <video controls="controls">
                                <source src="/media/videos/@item.Id.@item.Extension" type="video/mp4">
                                Su explorar no soporta nativamente la reproducción de videos.
                            </video>
                        </div>
                        <div class="card-body">
                            @if (string.IsNullOrEmpty(item.About))
                            {
                                <p class="text-muted mb-0"><i>Acerca de no especificado</i></p>
                            }
                            else
                            {
                                <p class="mb-0">@item.About</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (hasDocuments)
    {
        <hr class="my-5" />
        <h3 class="mb-0">Documentos</h3>
        <small class="text-muted lead">material de consulta adicional</small>
        <div class="row mt-3">
            @foreach (var item in Model.Documents)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-auto pr-0"><span class="mdi mdi-36px @item.Extension.AsExtensionToMDICssClass()"></span></div>
                                <div class="col">
                                    <a asp-action="Document" asp-controller="Download" asp-route-key="@item.Id"><b>@item.Name</b></a>
                                    <p class="mb-0">
                                        @if (item.Description == null)
                                        {
                                            <span class="text-muted italic">Sin descripción</span>
                                        }
                                        else
                                        {
                                            <span style="color: #6c757d; word-wrap: break-word;">@item.Description</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
