    <script type="text/javascript" src="~/lib/leaflet/plugins/draw/leaflet.draw.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/draw-style-editor/javascript/Leaflet.StyleEditor.min.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/measure/leaflet-measure.es.js"></script>
    <script type="text/javascript" src="~/lib/leaflet/plugins/ajax/leaflet.ajax.min.js"></script>
    <script type="text/javascript" src="~/lib/apexcharts/apexcharts.min.js"></script>
    <script type="text/javascript">
        // Workaround Does not work in Leaflet 1.8.0 #171
        L.Control.Measure.include({
	        // set icon on the capture marker
	        _setCaptureMarkerIcon: function () {
		        // disable autopan
		        this._captureMarker.options.autoPanOnFocus = false;

		        // default function
		        this._captureMarker.setIcon(
			        L.divIcon({
				        iconSize: this._map.getSize().multiplyBy(2)
			        })
		        );
	        },
        });

        var highlightLayer;

        $(document).ready(function () {
            var map = L.map('map', {
                fullscreenControl: true,
                fullscreenControlOptions: {
                    position: 'topleft'
                },
                scrollWheelZoom: false,
                attributionControl: false
