                        }
                    }
                    if (feature.properties['Tasa'] >= 32.400000 && feature.properties['Tasa'] <= 34.600000) {
                        return {
                            opacity: 1,
                            color: 'rgba(35,35,35,1.0)',
                            dashArray: '',
                            lineCap: 'butt',
                            lineJoin: 'miter',
                            weight: 1.0,
                            fill: true,
                            fillOpacity: 1,
                            fillColor: 'rgba(254,153,41,1.0)',
                            interactive: true,
                        }
                    }
                    if (feature.properties['Tasa'] >= 34.600000 && feature.properties['Tasa'] <= 36.800000) {
                        return {
                            opacity: 1,
                            color: 'rgba(35,35,35,1.0)',
                            dashArray: '',
                            lineCap: 'butt',
                            lineJoin: 'miter',
                            weight: 1.0,
                            fill: true,
                            fillOpacity: 1,
                            fillColor: 'rgba(217,95,14,1.0)',
                            interactive: true,
                        }
