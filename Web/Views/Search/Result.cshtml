@using MOROPO.CIMAC.Atlas.Camaguey.Web.Extensions

@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.SearchResultViewModel

@{
    const string TITLE = "Búsqueda";

    ViewData["Title"] = TITLE;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = @TITLE
        }
    };

    Layout = "_NavigableFrontendLayout";
}

<h4 class="display-4 mb-4">@TITLE</h4>

@if (Model.InformationResourceKind == null || Model.InformationResourceKind.Value == MOROPO.CIMAC.Atlas.Camaguey.Web.Enumerations.InformationResourceKind.Section)
{
    <h5 class="mt-3">Resultados para Secciones</h5>
    <hr />

    @if (Model.Sections == null || Model.Sections.Length <= 0)
    {
        <p class="mb-3 text-muted">No se encontraron coincidencias</p>
    }
    else
    {
        <div class="row">
        @foreach (var item in Model.Sections)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card shadow-sm" style="margin-bottom: 2.0rem!important;">
                    <div class="card-body">
                        <h4 class="card-title"><a asp-action="index" asp-controller="section" asp-route-key="@item.Id">@item.Name</a></h4>
                        <div class="text-truncate text-wrap" style="height: 72px;">
                            @Html.Raw(@item.Description)
                        </div>
                    </div>
                </div>
            </div>
        }            
        </div>
    }
}

