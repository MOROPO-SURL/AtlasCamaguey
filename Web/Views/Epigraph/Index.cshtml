@using MOROPO.CIMAC.Atlas.Camaguey.Web.Extensions

@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.EpigraphIndexViewModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Epigraph", ViewLocalizer);

    Layout = "_FrontendLayout";
}

@section styles
{
    <style type="text/css">
        .epigraph-img {
            height: 225px;
            background-repeat: no-repeat;
            background-color: black;
            background-size: cover;
        }
    </style>
}

<div style="padding: 2.0rem!important;">
    <h4 class="mb-0">Epígrafe</h4>
    <p class="display-4">@Model.Epigraph.Name</p>
    <div style="font-size: 1.5rem;">
        @if (Model.Epigraph.ImageId != null)
        {
            <img class="img-thumbnail float-left mr-3 w-25" src="~/media/images/@Model.Epigraph.ImageId.@Model.Epigraph.ImageExtension" title="@Model.Epigraph.Name" />
        }
        @Html.Raw(Model.Epigraph.Description)
    </div>
    <div class="clearfix"></div>
</div>
<div class="bg-light" style="padding: 2.0rem!important; padding-bottom: 0!important;">
    <h2 class="mb-0">Mapas</h2>
    <small class="text-muted lead">y sus contenidos complementarios</small>
    <div class="row mt-4">
        @foreach (var item in Model.Maps)
        {
            <div class="col-md-6 col-sm-12">
                <div class="card shadow-sm" style="margin-bottom: 2.0rem!important;">
                    <img class="card-img-top" role="img" src="http://qgis.moropo.cu/cgi-bin/qgis_mapserv.fcgi?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=-432786,4372992,3358959,7513746&SRS=EPSG:3857&WIDTH=665&HEIGHT=551&LAYERS=countries&FORMAT=image/jpeg" />
                    <div class="card-body">
                        <h4 class="card-title">@item.Name</h4>
                        <div class="text-truncate text-wrap" style="height: 72px;">
                            @Html.Raw(@item.Description)
                        </div>
                        <a class="btn btn-outline-primary mt-3" asp-action="index" asp-controller="map" asp-route-key="@item.Id">Mostrar</a>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Images.Length > 0)
    {
        <h3 class="mt-3 mb-0">Imágenes</h3>
        <small class="text-muted lead">instantáneas relacionadas a la temática</small>
        <div class="card-columns mt-3">
            @foreach (var item in Model.Images)
            {
                <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                    <img class="card-img" src="~/media/images/@item.Id.@item.Extension" />
                </div>
            }
        </div>
    }
    @if (Model.Videos.Length > 0)
    {
        <h3 class="mt-3 mb-0">Videos</h3>
        <small class="text-muted lead">audiovisuales representativos disponibles</small>
        <div class="row mt-3">
            @foreach (var item in Model.Videos)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="embed-responsive embed-responsive-16by9">
                            <video controls="controls">
                                <source src="/media/videos/@item.Id.@item.Extension" type="video/mp4">
                                Su explorar no soporta nativamente la reproducción de videos.
                            </video>
                        </div>
                        <div class="card-body">
                            @if (string.IsNullOrEmpty(item.About))
                            {
                                <p class="text-muted mb-0"><i>Acerca de no especificado</i></p>
                            }
                                else
                            {
                                <p class="mb-0">@item.About</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (Model.Documents.Length > 0)
    {
        <h3 class="mt-3 mb-0">Documentos</h3>
        <small class="text-muted lead">material de consulta adicional</small>
        <div class="row mt-3">
            @foreach (var item in Model.Documents)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card shadow-sm" style="margin-bottom: 1.25rem !important;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-auto pr-0"><span class="mdi mdi-36px @item.Extension.AsExtensionToMDICssClass()"></span></div>
                                <div class="col">
                                    <a asp-action="Document" asp-controller="Download" asp-route-key="@item.Id"><b>@item.Name</b></a>
                                    <p class="mb-0">
                                        @if (item.Description == null)
                                        {
                                            <span class="text-muted italic">Sin descripción</span>
                                        }
                                        else
                                        {
                                            <span style="color: #6c757d; word-wrap: break-word;">@item.Description</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>