@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.SectionIndexViewModel

@{
    const string HEADER = "Sección";
    
    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = string.Format("<b>Sección</b>: {0}", Model.Current.Name)
        }
    };

    Layout = "_ThematicNavigableFrontendLayout";
}

@section styles
{
    <style type="text/css">
        .epigraph-img {
            height: 225px;
            background-repeat: no-repeat;
            background-color: black;
            background-size: cover;
        }

        #nav-thematic .list-group-item {
            padding: 0.65rem;
        }

        #nav-thematic:first-child {
            border-top: 1px solid rgba(0,0,0,.125);
        }

        #nav-thematic .list-group-item > div.section-nav-item-head > div.row > span.mdi-chevron-up {
            transition: all 0.3s ease;
        }

        #nav-thematic .list-group-item > div.section-nav-item-head.collapsed > div.row > span.mdi-chevron-up {
            -webkit-transform: rotate(180deg);
            -moz-transform: rotate(180deg);
            -ms-transform: rotate(180deg);
            transform: rotate(180deg);
        }

        #nav-thematic .list-group-item .card-body {
            margin-top: 0.25rem;
        }

        #nav-thematic .list-group-item div.row.no-gutters > span {
            align-self: center;
        }       

        #nav-thematic .list-group-item div.row.no-gutters > span.col {
            margin: 0 0.25rem;
        }
    </style>
}

@section thematic_navigation
{
    <div id="nav-thematic" class="accordion">
    @foreach (var item in Model.Sections)
    {
        var listGroupItemCSSClasses = item.Id == Model.Current.Id ? "list-group-item bg-light" : "list-group-item";
        var listGroupItemHeadContentCSSClasses = item.Id == Model.Current.Id ? "row no-gutters text-info" : "row no-gutters";
        var listGroupItemBodyItemsCSSClasses = item.Id == Model.Current.Id ? "list-group-item bg-light" : "list-group-item";

        <div class="@listGroupItemCSSClasses">
            <div id="section-nav-item-@item.Id-head" class="section-nav-item-head collapsed" data-toggle="collapse" data-target="#section-nav-item-@item.Id-content" aria-expanded="true" aria-controls="section-nav-item-2-content">
                <div class="@listGroupItemHeadContentCSSClasses">
                    <span class="col-auto mdi mdi-24px mdi-bookmark"></span>
                    <span class="col">
                        @if (item.Id == Model.Current.Id)
                        {
                            <b>@item.Name</b>
                        }
                        else
                        {
                            <span>@item.Name</span>
                        }
                    </span>
                    <span class="col-auto mdi mdi-24px mdi-chevron-up"></span>
                </div>
            </div>            

            <div id="section-nav-item-@item.Id-content" class="collapse" aria-labelledby="section-nav-item-@item.Id-head" data-parent="#nav-thematic">
                @if (item.Id != Model.Current.Id)
                {
                    <hr class="bg-info" style="margin-top: 0.75rem" />
                    <a asp-action="Index" asp-controller="section" asp-route-key="@item.Id" class="card-link"><span class="mdi mdi-arrow-left-thick"></span> Detalles de la sección</a>
                }
                else
                {
                    <hr style="margin-top: 0.75rem" />
                }
                <b class="d-block mt-2">Epígrafes</b>
                <ul class="list-group">
                    @foreach (var _item in item.Epigraphs)
                    {
                        <li class="@listGroupItemBodyItemsCSSClasses">
                            <a asp-action="index" asp-controller="epigraph" asp-route-key="@_item.Id">
                                <div class="row no-gutters">
                                    <span class="col-auto mdi mdi-24px mdi-label"></span>
                                    <span class="col">@_item.Name</span>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    </div>
}

<h4 class="mb-0">Sección</h4>
<p class="display-4">@Model.Current.Name</p>
<div style="font-size: 1.5rem;">
    <img class="img-thumbnail float-left mr-3 w-25" src="~/media/images/@Model.Current.ImageId.@Model.Current.ImageExtension" title="@Model.Current.Name" />
    @Html.Raw(Model.Current.Description)
</div>
<div class="clearfix"></div>
<hr class="my-5" />
<h2 class="mb-0">Epígrafes</h2>
<small class="text-muted lead">espacios temáticos que agrupan mapas y contenidos complementarios</small>
<div class="row mt-4">
    @foreach (var item in Model.Current.Epigraphs)
    {
        <div class="col-md-6 col-sm-12">
            <div class="card shadow-sm" style="margin-bottom: 2.0rem!important;">
                <div class="card-body">
                    <h4 class="card-title">@item.Name</h4>
                    <div class="text-truncate text-wrap" style="height: 72px;">
                        @Html.Raw(@item.Description)
                    </div>
                    <a class="btn btn-outline-primary mt-3" asp-action="index" asp-controller="epigraph" asp-route-key="@item.Id">Descubrir</a>
                </div>
            </div>
        </div>
    }
</div>