@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.SectionIndexViewModel

@{
    const string HEADER = "Sección";
    
    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = string.Format("<b>Sección</b>: {0}", Model.Section.Name)
        }
    };

    Layout = "_NavigableFrontendLayout";
}

@section styles
{
    <style type="text/css">
        .epigraph-img {
            height: 225px;
            background-repeat: no-repeat;
            background-color: black;
            background-size: cover;
        }

        #nav-thematic .list-group-item {
            padding: 0.65rem;
        }

        #nav-thematic .list-group-item > div.section-nav-item-head > div.row > span.mdi-chevron-down {
            transition: all 0.3s ease;
         }

        #nav-thematic .list-group-item > div.section-nav-item-head.collapsed > div.row > span.mdi-chevron-down {
            -webkit-transform: rotate(180deg);
            -moz-transform: rotate(180deg);
            -ms-transform: rotate(180deg);
            transform: rotate(180deg);
        }

        #nav-thematic .list-group-item .card-body {
            margin-top: 0.25rem;
        }

        #nav-thematic .list-group-item div.row.no-gutters > span {
            align-self: center;
        }       

        #nav-thematic .list-group-item div.row.no-gutters > span.col {
            margin: 0 0.25rem;
        }
    </style>
}

