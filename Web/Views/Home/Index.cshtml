@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Frontend.HomeIndexViewModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Home", ViewLocalizer);

    Layout = "_FrontendLayout";
}

@section styles
{
    <style type="text/css">
        #sections-block-back .row > div[class*='col-'] {
          display: flex;
          flex:1 0 auto;
        }

        .bg-img {
            background-repeat: no-repeat;
            background-color: black;
            background-size: cover;
        }
        .section-img-overlay {
            position: absolute;
            top: 0;
            width: 100%;
            height: 100%;
        }
        .carousel-control-action {
            background: none;
        }
    </style>
}

<div class="row bg-white no-gutters">
    <div class="col-md-6 col-sm-12">
        <img class="float-left w-25" src="~/img/identity/banner_complement_left.svg" />
        <img class="float-right w-25" src="~/img/identity/banner_complement_right_short.svg" />
        <table class="table table-borderless table-sm mb-0 w-auto h-100">
            <tbody>
                <tr>
                    <td class="text-center px-0 py-3" style="vertical-align: middle;">
                        <img src="~/img/identity/AWC_Horizontal_Color_Reducción.svg" />
                        <p class="lead text-muted text-wrap mt-3 mb-0">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="clearfix"></div>
    </div>
    <div class="col-md-6 col-sm-12 h">
        <div id="carousel-main" class="carousel slide h-100 d-md-block d-none" data-ride="carousel">
            <ol class="carousel-indicators">
                <li data-target="#carousel-main" data-slide-to="0" class="active"></li>
                <li data-target="#carousel-main" data-slide-to="1"></li>
                <li data-target="#carousel-main" data-slide-to="2"></li>
            </ol>
            <div class="carousel-inner h-100" style="position: absolute;">
                <div class="carousel-item bg-img h-100 active" role="img" style="background-image: url('/img/slides/1.jpg');">
                </div>
                <div class="carousel-item bg-img h-100" style="background-image: url('/img/slides/2.jpg');">
                </div>
                <div class="carousel-item bg-img h-100" style="background-image: url('/img/slides/3.jpg');">
                </div>
            </div>
            <button class="carousel-control-action carousel-control-prev border-0" type="button" data-target="#carousel-main" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Anterior</span>
            </button>
            <button class="carousel-control-action carousel-control-next border-0" type="button" data-target="#carousel-main" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Siguiente</span>
            </button>
        </div>

    </div>
</div>

<div id="sections-block" class="bg-light" style="padding: 2.0rem!important; padding-bottom: 0!important;">
    <h4 class="display-4 mb-0">Secciones</h4>
    <small class="text-muted lead">espacios temáticos que agrupan epígrafes, mapas y contenidos complementarios</small>
    <div class="row row-cols-1 row-cols-lg-4 row-cols-md-3 row-cols-sm-2 mt-4">
        @foreach (var item in Model.Sections)
        {
            <div class="col" style="padding-bottom: 2.0rem!important;">
                <div class="card shadow-sm h-100">
                    <div class="card-img-top bg-img embed-responsive embed-responsive-4by3" role="img" style="background-image: url('/media/images/@item.ImageId.@item.ImageExtension');">
                        <img class="section-img-overlay" src="~/img/identity/ovelray.png" />    
                    </div>
                    <div class="card-body text-center pb-0">
                        <h5 class="card-title">@item.Name</h5>
                    </div>
                    <div class="card-footer text-center bg-white border-top-0 p-4" style="padding-top: 0!important;">
                        <a class="btn btn-outline-primary" asp-action="index" asp-controller="section" asp-route-key="@item.Id">Descubrir</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>