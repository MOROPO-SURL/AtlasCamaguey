@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.RichTextBlockDisplayViewModel

@{
    const string TITLE = "Contacto";

    ViewData["Title"] = TITLE;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-home-variant\" style=\"margin-right: 4px;\"></span> Inicio",
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = @TITLE
        }
    };

    Layout = "_NavigableFrontendLayout";
}

@section styles
{
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <style type="text/css">
        #map {
            height: 360px;
        }
    </style>
}

@section scripts
{
    <script type="text/javascript" src="~/lib/leaflet/leaflet.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var map = L.map('map', {
                scrollWheelZoom: false
            }).setView([21.3792,-77.9184], 16);

            //var drawingLayer = new L.featureGroup().addTo(map);

            var baseLayer = new L.tileLayer('http://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);
        });
    </script>
}

<h4 class="display-4">@TITLE</h4>

<div class="container my-5">
    <img src="~/img/identity/AWC_Horizontal_Color_Reducción.svg" />
</div>

<div class="card">
    <div class="row no-gutters">
        <div class="col-md-6">
            <div class="card-body">
                @Html.Raw(Model.Content)
            </div>
        </div>
        <div id="map" class="col-md-6"></div>
    </div>
</div>

<div class="container mt-5">
    <h2>Escríbenos</h2>
    <form>
        <label>Nombre:</label>
        <input type="text" name="name" class="form-control mb-3" />
        <label>Correo electrónico:</label>
        <input type="email" name="email" class="form-control mb-3" />
        <label>Teléfono:</label>
        <input type="tel" name="phone" class="form-control mb-3" />
        <label>Asunto:</label>
        <input type="text" name="subject" class="form-control mb-3" />
        <label>Mensaje:</label>
        <textarea name="message" rows="8" class="form-control mb-3"></textarea>

        <input type="submit" class="btn btn-primary" value="Enviar" />
    </form>
</div>