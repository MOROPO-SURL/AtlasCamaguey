<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<AssemblyName>MOROPO.CIMAC.Atlas.Camaguey.Web</AssemblyName>
		<RootNamespace>MOROPO.CIMAC.Atlas.Camaguey.Web</RootNamespace>
		<Product>AtlasCamaguey</Product>
		<Authors>MOROPO DotNet DevTeam</Authors>
		<Company>MOROPO S.U.R.L.</Company>
		<Copyright>© CIMAC - MOROPO 2023, Todos los derechos reservados.</Copyright>
		<Version>0.3.0</Version>
		<PackageProjectUrl>https://www.moropo.cu/</PackageProjectUrl>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(RunConfiguration)' == 'Web' " />
	<PropertyGroup Condition=" '$(RunConfiguration)' == 'Staging' " />
	<ItemGroup>
		<Compile Remove="dpkeys\**" />
		<Compile Remove="logs\**" />
		<Compile Remove="wwwroot\media\**" />
		<Content Remove="dpkeys\**" />
		<Content Remove="logs\**" />
		<Content Remove="wwwroot\media\**" />
		<EmbeddedResource Remove="dpkeys\**" />
		<EmbeddedResource Remove="logs\**" />
		<EmbeddedResource Remove="wwwroot\media\**" />
		<None Remove="dpkeys\**" />
		<None Remove="logs\**" />
		<None Remove="wwwroot\media\**" />
		<None Remove="Controllers\Backend\Complements\" />
		<None Remove="Components\" />
		<None Remove="Views\Shared\Components\" />
		<None Remove="Views\Shared\Components\BackendNavbar\" />
		<None Remove="Resources\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GuamaFramework.Core.Presentation.Web.API" Version="6.0.0.16" />
		<PackageReference Include="GuamaFramework.Core.Security.Common.Presentation.Web.Frontend" Version="6.0.0.15" />
		<PackageReference Include="GuamaFramework.Media.Presentation.Web.Common" Version="6.0.0.15" />
		<PackageReference Include="GuamaFramework.Security.Personal.Presentation.Web.Backend" Version="6.0.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="7.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="7.0.4" />
		<PackageReference Include="Rotativa.AspNetCore" Version="1.2.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="7.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
		<PackageReference Include="SkiaSharp" Version="2.88.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Persistence\Persistence.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\lib\ckeditor\" />
	  <Folder Include="Views\Shared\Components\" />
	  <Folder Include="Views\Shared\Components\BackendNavbar\" />
	  <Folder Include="Resources\" />
	</ItemGroup>
</Project>
