@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.MapKeyWordsManagementViewModel

@{
    const string HEADER = "Modificar Mapa";

    var title = string.Format("{0} (Palabras Clave)", HEADER);

    ViewData["Title"] = title;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Mapas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = title
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/bootstrap-combobox/css/bootstrap-combobox.css" />
    <style type="text/css">
        .dropdown-toggle {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            margin-left: -1px;
            line-height: 36px;
        }

        .dropdown-toggle::after {
            margin: 0 5px;
        }

        ul.dropdown-menu{
            width: 100%;
        }
    </style>
}

@section scripts {
    <script src="~/lib/bootstrap-combobox/js/bootstrap-combobox.js"></script>
    <script type="text/javascript">
        $('select#keyWordId').combobox();
    </script>
}

<div class="card mb-3 mt-4">
    <div class="card-header">
        <h4>@HEADER</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="Edit" asp-route-key="@Model.Map.Id">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditAuthors" asp-route-key="@Model.Map.Id">Autores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditImages" asp-route-key="@Model.Map.Id">Imágenes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditVideos" asp-route-key="@Model.Map.Id">Videos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditDocuments" asp-route-key="@Model.Map.Id">Documentos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Palabras Claves</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-0">
        @await Html.PartialAsync("_SummaryPartial", Model.Map)

        <div class="modal fade" id="add" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-title">Agregar Palabra Clave</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("addkeyword", "maps", new { key = Model.Map.Id }, FormMethod.Post, true, null))
                    {
                        <div class="modal-body">
                            @if (Model.AvailableKeyWordSelectListItems.Length > 0)
                            {
                                @Html.DropDownList("keyWordId", Model.AvailableKeyWordSelectListItems, "Seleccione o búsque aquí ...", new { @class = "form-control" })
                            }else{
                                <div class="text-muted font-italic">No hay otras palabras clave disponibles para agregar</div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (Model.KeyWords.Length <= 0)
        {
            <p class="text-muted mb-3">Sin elementos que mostrar</p>
        }
        else
        {
            <div class="card-columns">
                @foreach (var item in Model.KeyWords)
                {
                    <div class="card" style="margin-bottom: 1.25rem !important;">
                        <div class="card-body">
                            <div class="row">
                                <h3 class="col mb-0">@item.Name</h3>
                                <div class="col-auto">
                                    <a class="btn btn-danger" href="#" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can"></span></a>
                                </div>
                            </div>
                            <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        @using (Html.BeginForm("deletekeyword", "maps", new { key = Model.Map.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                        {
                                            @Html.Hidden("keyWordId", item.Id)

                                            <div class="modal-header">
                                                <h4 class="modal-title" id="delete-image-@item.Id-lable">Eliminar Palabra Clave</h4>
                                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">Esta seguro que desea eliminar la palabra clave seleccionada?</p>
                                            </div>
                                            <div class="modal-footer" style="margin-top: 0;">
                                                <button type="submit" class="btn btn-danger">Eliminar</button>
                                                <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>