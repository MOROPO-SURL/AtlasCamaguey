@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.Management.MapMetadataEntriesManagementViewModel

@{
    const string HEADER = "Modificar Mapa";

    var title = string.Format("{0} (Metadatatos)", HEADER);

    ViewData["Title"] = title;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Metadatatos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = title
        }
    };

    Layout = "_BackendLayout";
}

<div class="card mb-3 mt-4">
    <div class="card-header">
        <h4>@HEADER</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="Edit" asp-route-key="@Model.Map.Id">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditLayers" asp-route-key="@Model.Map.Id">Capas</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditAuthors" asp-route-key="@Model.Map.Id">Autores</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditImages" asp-route-key="@Model.Map.Id">Imágenes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditVideos" asp-route-key="@Model.Map.Id">Videos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditDocuments" asp-route-key="@Model.Map.Id">Documentos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="EditKeyWords" asp-route-key="@Model.Map.Id">Palabras Claves</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Metadatos</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("_SummaryPartial", Model.Map)

        <div class="modal fade" id="add-item" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="add-collaborator-title">Agregar Metadatato</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    @using (Html.BeginForm("addmetadataentry", "maps", new { key = Model.Map.Id }, FormMethod.Post, true, null))
                    {
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-auto mb-3">
                                    @Html.Label("name", "Nombre", new { @class = "control-label" })
                                    @Html.TextBox("name", null, new { @class = "form-control" })
                                    @Html.ValidationMessage("name", null, new { @class = "text-danger" })
                                </div>
                                <div class="col-auto mb-3">
                                    @Html.Label("value", "Valor", new { @class = "control-label" })
                                    @Html.TextBox("value", null, new { @class = "form-control" })
                                    @Html.ValidationMessage("value", null, new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                            <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div style="border: 1px solid #DDD; border-radius: 4px;">
            <table class="table" style="margin: 0;">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Valor</th>
                        <th style="width: 196px;">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MetadataEntries.Length <= 0)
    {
                        <tr><td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.MetadataEntries)
                        {
                            <tr>
                                <td style="vertical-align: middle;">@item.Name</td>
                                <td style="vertical-align: middle;">@item.Value</td>
                                <td style="vertical-align: middle;">
                                    <div class="btn-group btn-group-sm">
                                        <button role="button" class="btn btn-light" data-toggle="modal" data-target="#edit-@item.Id"><span class="mdi mdi-square-edit-outline"></span>Modificar</button>
                                        <button role="button" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can-outline"></span>Eliminar</button>
                                    </div>
                                    <div class="modal fade" id="edit-@item.Id" tabindex="-1" role="dialog" aria-labelledby="edit-@item.Id-lable" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                @using (Html.BeginForm("editmetadataentry", "maps", new { key = Model.Map.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                                {
                                                    @Html.Hidden("entryId", item.Id)

                                                    <div class="modal-header">
                                                        <h4 class="modal-title" id="delete-@item.Id-lable">Modificar Metadato</h4>
                                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="row">
                                                            <div class="col-auto mb-3">
                                                                @Html.Label("name", "Nombre", new { @class = "control-label" })
                                                                @Html.TextBox("name", item.Name, new { @class = "form-control" })
                                                                @Html.ValidationMessage("name", null, new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-auto mb-3">
                                                                @Html.Label("value", "Valor", new { @class = "control-label" })
                                                                @Html.TextBox("value", item.Value, new { @class = "form-control" })
                                                                @Html.ValidationMessage("value", null, new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer" style="margin-top: 0;">
                                                        <button type="submit" class="btn btn-primary">Aplicar</button>
                                                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                @using (Html.BeginForm("deletemetadataentry", "maps", new { key = Model.Map.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                                {
                                                    @Html.Hidden("entryId", item.Id)

                                                    <div class="modal-header">
                                                        <h4 class="modal-title" id="delete-@item.Id-lable">Eliminar Metadato</h4>
                                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="mb-0">Esta seguro que desea eliminar el metadato seleccionado?</p>
                                                    </div>
                                                    <div class="modal-footer" style="margin-top: 0;">
                                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-item">Agregar</a>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
</div>