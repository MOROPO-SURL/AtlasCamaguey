@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.Input.MapInputViewModel

@{
    const string HEADER = "Modificar Mapa";

    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Mapas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

@section scripts
{
    <script type="text/javascript" src="/lib/ckeditor/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create( document.querySelector( '#Description' ) )
            .then( editor => {
                editor.editing.view.change(writer=>{
                    writer.setStyle('height', '400px', editor.editing.view.document.getRoot());
                });
            } )
            .catch( error => {
                console.error( error );
            } );

        $(function() {
            $(document).on("change", "#ImageFile", function() {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function() {
                        $('#ImageFilePreview').attr('src', this.result);
                        $('#ImageFilePreview').show();
                    }
                }

            });
        });
    </script>
}

@using (Html.BeginForm("edit", "maps", new { Area = "atlas", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3 mt-4">
       <div class="card-header">
            <h4>@HEADER</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditLayers" asp-route-key="@Model.Id">Capas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditAuthors" asp-route-key="@Model.Id">Autores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditImages" asp-route-key="@Model.Id">Imágenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditVideos" asp-route-key="@Model.Id">Videos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditDocuments" asp-route-key="@Model.Id">Documentos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditKeyWords" asp-route-key="@Model.Id">Palabras Claves</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 col-lg-2 mb-3">
                    @Html.LabelFor(model => model.Id, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Id, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.Id, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-9 col-lg-10 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class=" col-sm-6 col-md-3 col-lg-2 mb-3">
                    @Html.LabelFor(model => model.Scale, new { @class = "control-label" }) <span class="small text-muted"></span>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="basic-addon1">1:</span>
                        </div>
                        @Html.TextBoxFor(model => model.Scale, new { @class = "form-control" })
                    </div>                
                    @Html.ValidationMessageFor(model => model.Scale, null, new { @class = "text-danger" })
                </div>
                <div class="col-auto mb-3">
                    @Html.LabelFor(model => model.Priority, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Priority, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Priority, null, new { @class = "text-danger" })
                </div>
            </div>            
            <div class="row">
                <div class="col-md-6 mb-1 mb-md-3">
                    @Html.LabelFor(model => model.ImageFile, new { @class = "control-label" }) <span class="small text-muted">(opcional)</span>
                    <input type="file" class="form-control" id="ImageFile" name="ImageFile" />
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                    @if (Model.ImageId != null)
                    {
                        var imageSource = string.Format("/media/images/{0}{1}", Model.ImageId, Model.ImageExtension);

                        <img src="@imageSource" class="img-fluid mt-2" id="ImageFilePreview" />
                    }
                    else
                    {
                        <img class="img-fluid mt-2" id="ImageFilePreview" style="display: none;" />
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <div>
                        @Html.LabelFor(model => model.MetadataFile, new { @class = "control-label" })
                        <input type="file" class="form-control" id="MetadataFile" name="MetadataFile" />
                        <table class="table" style="margin: 0;">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MetadataEntries.Length <= 0)
                                {
                                    <tr><td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td></tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.MetadataEntries)
                                    {
                                        <tr>
                                            <td style="vertical-align: middle;">@item.Name</td>
                                            <td style="vertical-align: middle;">@item.Value</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
            <div>
                @Html.Label(null, "Bloques complementarios para la renderización de Capas", new { @class = "control-label" })
                <ul class="nav nav-tabs">
                    <li class="nav-item"><a class="nav-link active" href="#prelayersjsblock" data-toggle="tab">Bloque Javascript Previo</a></li>
                    <li class="nav-item"><a class="nav-link" href="#postlayersjsblock" data-toggle="tab">Bloque Javascript Posterior</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane pt-3 active" id="prelayersjsblock">
                        @Html.TextAreaFor(model => model.PreLayersJSBlock, 6, 1, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.PreLayersJSBlock, null, new { @class = "text-danger" })
                    </div>
                    <div class="tab-pane pt-3" id="postlayersjsblock">
                        @Html.TextAreaFor(model => model.PostLayersJSBlock, 6, 1, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.PostLayersJSBlock, null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}