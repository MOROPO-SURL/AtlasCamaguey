@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.Input.ThemeInputViewModel

@{
    const string HEADER = "Modificar Temática";

    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Temáticas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("edit", "themes", new { Area = "atlas", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)

    @Html.ValidationSummary(true)
    <div class="card mb-3 mt-4">
        <div class="card-header">
            <h4>@HEADER</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="EditMaps" asp-route-key="@Model.Id">Mapas</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-auto mb-3">
                    @Html.LabelFor(model => model.Priority, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Priority, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Priority, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.EpigraphId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.EpigraphId, Model.EpigraphSelectListItems, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.EpigraphId, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}