@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.SectionDisplayViewModel

@{
    const string HEADER = "Eliminar Sección";

    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
{
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Secciones",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

<h3 class="mb-3 mt-4">Está seguro que desea eliminar la sección detallada a continuación?</h3>
<dl>
    <dt>Nombre</dt>
    <dd class="mb-0">@Html.DisplayFor(model => model.Name)</dd>
</dl>
<hr />

@using (Html.BeginForm("delete", "sections", new { Area = "atlas", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
    </div>
}
