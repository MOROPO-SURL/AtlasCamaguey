@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.EpigraphVideosManagementViewModel

@{
    const string HEADER = "Modificar Epígrafe";

    var title = string.Format("{0} (Videos)", HEADER);

    ViewData["Title"] = title;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Epígrafes",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = title
        }
    };

    Layout = "_BackendLayout";
}

<div class="card mb-3 mt-4">
    <div class="card-header">
        <h4>@HEADER</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Edit", Model.Epigraph.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("EditMaps", Model.Epigraph.Id)">Mapas</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("EditImages", Model.Epigraph.Id)">Imágenes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Videos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("EditDocuments", Model.Epigraph.Id)">Documentos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("EditKeyWords", Model.Epigraph.Id)">Palabras Claves</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-0">
        @await Html.PartialAsync("_SummaryPartial", Model.Epigraph)

        @if (Model.Videos.Length <= 0)
        {
            <p class="text-muted mb-3">Sin elementos que mostrar</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model.Videos)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <div class="embed-responsive embed-responsive-16by9">
                                    <video controls="controls">
                                        <source src="/media/videos/@item.Id.@item.Extension" type="video/mp4">
                                        Su explorar no soporta nativamente la reproducción de videos.
                                    </video>
                                </div>
                                @if (string.IsNullOrEmpty(item.About))
                                {
                                    <h5 class="text-muted mb-0 mt-3"><i>Acerca de no especificado</i></h5>
                                }
                                    else
                                {
                                    <h5 class="mb-0 mt-3">@item.About</h5>
                                }
                            </div>
                            <div class="card-footer">
                                <button class="btn btn-sm btn-light" data-toggle="modal" data-target="#edit-@item.Id"><span class="mdi mdi-square-edit-outline"></span> Modificar</button>
                                <button class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><span class="mdi mdi-trash-can"></span> Eliminar</button>
                            </div>
                            <div class="modal fade" id="edit-@item.Id" tabindex="-1" role="dialog" aria-labelledby="edit-@item.Id-lable" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        @using (Html.BeginForm("EditVideo", "epigraphs", new { key = Model.Epigraph.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                        {
                                            @Html.Hidden("videoId", item.Id)

                                            <div class="modal-header">
                                                <h4 class="modal-title" id="delete-image-@item.Id-lable">Modificar Video</h4>
                                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                            </div>
                                            <div class="modal-body">
                                                <div>
                                                    @Html.Label("about", "Acerca de", new { @class = "control-label" })
                                                    <textarea class="form-control" cols="1" rows="6" name="about">@item.About</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer" style="margin-top: 0;">
                                                <button type="submit" class="btn btn-primary">Modifcar</button>
                                                <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        @using (Html.BeginForm("DeleteVideo", "epigraphs", new { key = Model.Epigraph.Id }, FormMethod.Post, true, new { @class = "modal-content" }))
                                        {
                                            @Html.Hidden("videoId", item.Id)

                                            <div class="modal-header">
                                                <h4 class="modal-title" id="delete-image-@item.Id-lable">Eliminar Video</h4>
                                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">Esta seguro que desea eliminar el video seleccionado?</p>
                                            </div>
                                            <div class="modal-footer" style="margin-top: 0;">
                                                <button type="submit" class="btn btn-danger">Eliminar</button>
                                                <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" data-toggle="modal" data-target="#add-video">Agregar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>    
    <div class="modal fade" id="add-video" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="add-video-title">Agregar Video</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                @using (Html.BeginForm("addvideo", "epigraphs", new { key = Model.Epigraph.Id }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body">                    
                        <div class="mb-3">
                            @Html.Label("videoFile", "Archivo", new { @class = "control-label" })
                            <input type="file" class="form-control" id="videoFile" name="videoFile" />
                        </div>
                        <div>
                            @Html.Label("about", "Acerca de", new { @class = "control-label" })
                            <textarea class="form-control" cols="1" rows="6" name="about"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Agregar</button>
                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>