@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.EpigraphInputViewModel

@{
    const string HEADER = "Modificar Epígrafe";

    ViewData["Title"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("index", "dashboard", new { area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Epígrafes",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

@section scripts
{
    <script type="text/javascript" src="/lib/ckeditor/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create( document.querySelector( '#Description' ) )
            .then( editor => {
                editor.editing.view.change(writer=>{
                    writer.setStyle('height', '600px', editor.editing.view.document.getRoot());
                });
            } )
            .catch( error => {
                console.error( error );
            } );

        $(function() {
            $(document).on("change", "#ImageFile", function() {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function() {
                        $('#ImageFilePreview').attr('src', this.result);
                        $('#ImageFilePreview').show();
                    }
                }

            });
        });
    </script>
}

@using (Html.BeginForm("edit", "epigraphs", new { Area = "atlas", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.Id)

    @Html.ValidationSummary(true)
    <div class="card mb-3 mt-4">
        <div class="card-header">
            <h4>@HEADER</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditMaps", Model.Id)">Mapas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditImages", Model.Id)">Imágenes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditVideos", Model.Id)">Videos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditDocuments", Model.Id)">Documentos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditKeyWords", Model.Id)">Palabras Claves</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.SectionId, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.SectionId, Model.SectionSelectListItems, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SectionId, null, new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-1 mb-md-3">
                    @Html.LabelFor(model => model.ImageFile, new { @class = "control-label" }) <span class="small text-muted">(opcional)</span>
                    <input type="file" class="form-control" id="ImageFile" name="ImageFile" />
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                @if (Model.ImageId != null) {
                    var imageSource = string.Format("/media/images/{0}.{1}", Model.ImageId, Model.ImageExtension);
                
                    <img src="@imageSource" class="img-thumbnail" id="ImageFilePreview" />
                }
                else
                {
                    <img class="img-thumbnail" id="ImageFilePreview" style="display: none;" />
                }
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}