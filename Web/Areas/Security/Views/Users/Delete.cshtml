@using MOROPO.Framework.Guama.Core.Presentation.Models.View;

@model MOROPO.Framework.Guama.Security.Personal.Presentation.Web.Backend.Models.View.UserDisplayViewModel

@{
    ViewData["Title"] = "Eliminar Usuario";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Usuarios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar el usuario detallado a continuación?</h3>

<dl>
    <dt>@Html.DisplayNameFor(model => model.Id)</dt>
    <dd>@Html.DisplayFor(model => model.Id)</dd>
    <dt>@Html.DisplayNameFor(model => model.Enabled)</dt>
    <dd>@if (Model.Enabled) { <span class="mdi mdi-checkbox-marked-outline"></span> } else { <span class="mdi mdi-checkbox-blank-outline"></span> }</dd>
    <dt>@Html.DisplayNameFor(model => model.Created)</dt>
    <dd>@Html.DisplayFor(model => model.Created)</dd>
</dl>
@using (Html.BeginForm("delete", "users", new { Area = "security", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
    </div>
}
