@using MOROPO.Framework.Guama.Core.Presentation.Models.View;

@model MOROPO.Framework.Guama.Security.Personal.Presentation.Web.Backend.Models.View.UserInputViewModel

@{
    ViewData["Title"] = "Modificar Usuario";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Usuarios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

@section scripts {
    <script type="text/javascript">
        $(function () {
            $(document).on("change", "#ImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>
}

@using (Html.BeginForm("edit", "users", new { Area = "security", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header"><h4 class="mb-0">@ViewData["Title"]</h4></div>

        <div class="card-body">
            <div class="row">
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-4">
                    <div class="card mb-3">
                        @if (Model.ImageId == null)
                        {
                            <img src="~/img/default-person-picture.jpg" class="card-img-top" id="ImageFilePreview" />
                        }
                        else
                        {
                            var imageSource = string.Format("/media/images/{0}.{1}", Model.ImageId, Model.ImageExtension);

                            <img src="@imageSource" class="card-img-top" id="ImageFilePreview" />
                        }
                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.ImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-xl-10 col-lg-9 col-md-8 col-sm-8">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Id, new { @class = "control-label" })
                            <input type="text" readonly="readonly" value="@Model.Id" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.LastName, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.LastName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.LastName, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Habilitado
                        </label>
                        @Html.ValidationMessageFor(model => model.Enabled, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>
                <div class="col mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.PasswordChangeRequired) Debe cambiar la contraseña?
                        </label>
                        @Html.ValidationMessageFor(model => model.PasswordChangeRequired, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>
                <div class="col-sm-4 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.HasFullAccess) Es super usuario?
                        </label>
                        @Html.ValidationMessageFor(model => model.HasFullAccess, null, new { @class = "text-danger", style = "display: inline-block;" })
                    </div>
                </div>
            </div>

            <fieldset>
                <legend class="border-bottom h4">Roles</legend>
                @if (Model.SelectableRoles != null && Model.SelectableRoles.Count > 0)
                {
                    <div class="row">
                    @for (int i = 0; i < Model.SelectableRoles.Count; i++)
                    {
                        <div class="col-md-6">
                            @Html.EditorFor(subModel => subModel.SelectableRoles[i], "SelectionDescriptedGuidIDItemInputViewModel")
                        </div>
                    }
                    </div>
                }
                else
                {
                    <div>Sin elementos que mostrar.</div>
                }
            </fieldset>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}