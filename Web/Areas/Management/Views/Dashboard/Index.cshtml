@using MOROPO.Framework.Guama.Core.Security.Common.Presentation.Web.Frontend.Extensions
@using MOROPO.CIMAC.Atlas.Camaguey.Web.Extensions;

@model MOROPO.CIMAC.Atlas.Camaguey.Web.Models.View.Backend.HomeViewModel

@{
    ViewData["Title"] = GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer);

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\"></span> " + ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        .card .mdi {
            font-size: 48px;
        }

        .nav-link .mdi {
            font-size: 18px;
        }
    </style>
}

<div class="row">
    @foreach (var group in Model.Sections)
    {
        <div class="col-sm-6 mb-4">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">@group.Key</h5></div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var item in group.Value)
                        {
                            <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                @if (User.IsAuthorized(item.Role))
                                {
                                    <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                        @item.ToIconographyHtmlString()
                                        <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                    </a>
                                }
                                else
                                {
                                    <div class="text-muted">
                                        @item.ToIconographyHtmlString()
                                        <div>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>